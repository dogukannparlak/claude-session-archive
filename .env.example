# Session Archive settings: copy this file to `.env` and change what you need.
# Everything is optional; delete a line to get the default.
#   on / off   for switches        numbers: just write the number
#   paths: a folder or file path (~ works). Several paths: separate with commas.

# --- Basics ---
PORT=8765                # the viewer opens at http://127.0.0.1:PORT
OPEN_BROWSER=on          # open the browser when it starts (on / off)
IDLE_MINUTES=15          # gaps longer than this many minutes do not count as work time

# --- Folders ---
# Where Claude Code keeps your conversations (default: ~/.claude/projects).
# CLAUDE_FOLDERS=~/.claude/projects
# To also read a second folder (a backup, for example), add it after a comma:
# CLAUDE_FOLDERS=~/.claude/projects, ~/Documents/claude-backup/projects
# Where `session-archive backup` puts its copies:
# BACKUP_FOLDER=~/Documents/claude-session-backup/projects
# The Claude desktop app's session list (the macOS location is built in):
# APP_INDEX_FOLDER=~/Library/Application Support/Claude/claude-code-sessions

# --- Which icons to show (on / off) ---
SHOW_APP=on              # Claude Code app
SHOW_OBSIDIAN=on         # terminal started inside an Obsidian vault (a folder with .obsidian)
SHOW_TERMINAL=on         # normal terminal
SHOW_VSCODE=on           # VS Code
SHOW_SDK=on              # scripts / SDK
# "off" means that source gets no icon of its own (Obsidian off: those sessions show as Terminal).

# --- Your own icons ---
# Give a folder its own icon: folder=icon, several separated by commas.
# The icon is a name (server, folder, globe, cloud, code, bolt) or the path of your own
# .svg / .png / .webp / .jpg file (up to 256 KB).
# FOLDER_ICONS=~/work=server, ~/Documents/client-x=./icons/client-x.svg
