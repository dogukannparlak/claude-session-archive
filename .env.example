# Session Archive settings. Copy to `.env` (git-ignored) and edit.
# Precedence: command-line flag > real environment variable > this file > built-in default.
# Everything is optional; there are no secrets in this project.
# Which sources/icons exist (and their rules) is set in session-archive.json, not here:
# see docs/CONFIGURATION.md and `session-archive print-config`.

# Port the viewer listens on (127.0.0.1 only).
SESSION_ARCHIVE_PORT=8765

# Open the browser on start: true / false.
SESSION_ARCHIVE_OPEN_BROWSER=true

# Message gaps longer than this many minutes do not count as "active time".
SESSION_ARCHIVE_IDLE_MINUTES=15

# Transcript folders to read, separated like PATH (":" on macOS/Linux, ";" on Windows).
# Default: $CLAUDE_CONFIG_DIR/projects, else ~/.claude/projects. Add a backup folder here too.
# SESSION_ARCHIVE_PROJECTS_DIRS=~/.claude/projects:~/Documents/claude-session-backup/projects

# Where `session-archive backup` copies sessions to.
# SESSION_ARCHIVE_BACKUP_DIR=~/Documents/claude-session-backup/projects

# The desktop app's session index (used to pick app sessions). macOS default is built in.
# SESSION_ARCHIVE_APP_INDEX=~/Library/Application Support/Claude/claude-code-sessions
